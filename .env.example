# ==========================================================
# HealthGPT – Environment Configuration Template
# ==========================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=healthgpt_super_secure_jwt_secret_dev_2026
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=healthgpt_super_admin_jwt_secret_dev_2026

# Database Path (SQLite relational database with WAL mode)
DATABASE_PATH=server/database/healthgpt.db

# AI Provider Configuration ('builtin' | 'gemini' | 'openai')
# The built-in intelligent clinical triage engine works 100% offline out-of-the-box!
ACTIVE_AI_PROVIDER=builtin

# Optional Cloud AI API Keys (can also be configured via Admin Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
